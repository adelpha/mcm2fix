/* careerrace.rml: each control's own pictures (from the game's layouts). Made by tools/mcm2rml.py. */
#d-pclrace { decorator: image(/dat/PCLRACE/ProCircuitScreens/PCLastRace/PCLBG.tga); }
#pclrace-rbwFrame1 { decorator: image(/dat/PCLRACE/ProCircuitScreens/PCLastRace/PCLStndngsScreen.tga); }
#pclrace-Back { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2BackUp.tga); }
#pclrace-Back:hover, #pclrace-Back:focus-visible { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2BackLit.tga); }
#pclrace-Back:active { decorator: image(/dat/GLOBAL/Rev2GlobalSource/R2BackDown.tga); }
