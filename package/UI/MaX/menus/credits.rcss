/* credits.rml: each control's own pictures (from the game's layouts). Made by tools/mcm2rml.py. */
#credits-Back { decorator: image(/dat/GLOBAL/Resources/LeftArrowUp.tga); }
#credits-Back:hover, #credits-Back:focus-visible { decorator: image(/dat/GLOBAL/Resources/LeftArrowLit.tga); }
#credits-Back:active { decorator: image(/dat/GLOBAL/Resources/LeftArrowDown.tga); }
#credits-Back.disabled { decorator: image(/dat/GLOBAL/Resources/LeftArrowGrey.tga); }
