/* MCM2MaX menu style. Lengths in dp are 640x480 menu pixels (scaled to the
   window). Edit and save while the screen is open: it reloads at once. */

/* ---- basic elements (RmlUi has no built-in defaults) ---- */
body, div, p, h1, h2, form { display: block; }
body {
  width: 100%;
  height: 100%;
  font-family: LatoLatin;
  font-size: 13dp;
  color: #ffffff;
  font-effect: shadow(1dp 1dp #00001a);
}

/* ---- screen frame ---- */
#backdrop {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background-color: #00000099;
}
#panel {
  position: absolute;
  width: 560dp;
  height: 404dp;
  left: 50%;
  top: 50%;
  margin-left: -280dp;
  margin-top: -202dp;
  background-color: #141a46f0;
  border: 2dp #9ea6dc;
  border-radius: 8dp;
}
h1 {
  font-family: "Contrail One";
  font-weight: normal;
  font-size: 24dp;
  padding: 10dp 16dp 4dp 16dp;
  color: #ffffff;
}
#scroll {
  position: absolute;
  left: 8dp; right: 8dp;
  top: 46dp; bottom: 48dp;
  overflow-y: auto;
  padding: 0 8dp;
}
h2 {
  font-size: 12dp;
  font-weight: bold;
  color: #b8c0ff;
  margin: 10dp 0 2dp 0;
  padding-bottom: 2dp;
  border-bottom: 1dp #5a64a8;
}

/* ---- one setting per row ---- */
.row {
  display: flex;
  align-items: center;
  height: 24dp;
  padding: 0 6dp;
  border-radius: 4dp;
}
.row:hover { background-color: #ffffff14; }
.label { flex: 1; }
.note { color: #9aa2d8; font-size: 11dp; margin-left: 6dp; }
.value { width: 44dp; text-align: right; margin-right: 8dp; color: #d8dcff; }
.row.disabled .label, input:disabled { color: #8088b8; opacity: 0.55; }

/* Everything that can be picked: Tab and the arrow keys / d-pad move
   between them; Enter / A acts on it. */
input, select, button {
  tab-index: auto;
  nav: auto;
  focus: auto;
}

/* ---- checkbox ---- */
input.checkbox {
  width: 16dp;
  height: 16dp;
  border: 2dp #9ea6dc;
  border-radius: 3dp;
  background-color: #0a0e2c;
}
input.checkbox:hover { border-color: #ffffff; }
input.checkbox:checked {
  background-color: #4f66e0;
  decorator: image(images/tick.png);
}
input.checkbox:checked:hover { background-color: #6f86ff; }

/* ---- slider ---- */
input.range {
  width: 150dp;
  height: 16dp;
  border: 2dp #00000000;
  border-radius: 3dp;
}
input.range slidertrack {
  margin-top: 6dp;
  height: 4dp;
  background-color: #5a64a8;
  border-radius: 2dp;
}
input.range sliderbar {
  width: 10dp;
  height: 14dp;
  margin-top: -1dp;
  background-color: #c8ceff;
  border-radius: 3dp;
}
input.range sliderbar:hover, input.range sliderbar:active { background-color: #ffffff; }
input.range sliderarrowdec, input.range sliderarrowinc { width: 0; height: 0; }

/* ---- drop-down list ---- */
select {
  width: 150dp;
  height: 18dp;
  border: 2dp #9ea6dc;
  border-radius: 3dp;
  background-color: #0a0e2c;
  text-align: left;
}
select selectvalue { padding: 1dp 6dp; height: 14dp; }
select selectarrow {
  width: 14dp;
  height: 14dp;
  background-color: #5a64a8;
  decorator: image(images/arrow-down.png);
}
select selectbox {
  margin-top: 1dp;
  background-color: #0a0e2c;
  border: 2dp #9ea6dc;
  padding: 2dp 0;
}
select selectbox option { padding: 2dp 6dp; }
select selectbox option:hover, select selectbox option:checked { background-color: #3a4590; }

/* ---- buttons along the bottom ---- */
#bottom {
  position: absolute;
  left: 16dp; right: 16dp; bottom: 10dp;
  height: 28dp;
  display: flex;
  align-items: center;
}
#hint { flex: 1; color: #9aa2d8; font-size: 11dp; }
button {
  display: inline-block;
  width: 96dp;
  height: 24dp;
  line-height: 20dp;
  text-align: center;
  border: 2dp #9ea6dc;
  border-radius: 4dp;
  background-color: #2a3378;
  font-weight: bold;
}
button:hover { background-color: #3a4590; }
button:active { background-color: #1a2058; }

/* "* after restarting the game": shown once such a setting is changed. */
#restart { display: none; color: #ffd84a; font-size: 11dp; margin-right: 12dp; }
body.restart-needed #restart { display: block; }

/* Scroll bar of the settings list. */
scrollbarvertical { width: 6dp; margin-left: 4dp; }
scrollbarvertical slidertrack { background-color: #ffffff10; border-radius: 3dp; }
scrollbarvertical sliderbar { background-color: #9ea6dc; border-radius: 3dp; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { width: 0; height: 0; }

/* Where the keyboard / controller is: a bright outline (last, so it wins). */
input:focus-visible, input.checkbox:focus-visible, input.range:focus-visible, select:focus-visible,
button:focus-visible {
  border-color: #ffd84a;
}
input.range:focus-visible sliderbar { background-color: #ffd84a; }
button:focus-visible { background-color: #3a4590; }
